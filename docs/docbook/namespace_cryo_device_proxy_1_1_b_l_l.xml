</listitem>
            <listitem><para>class <link linkend="_class_cryo_device_proxy_1_1_b_l_l_1_1_update_usage_stats_list_request_json">UpdateUsageStatsListRequestJson</link></para>

<para>The class <computeroutput><link linkend="_class_cryo_device_proxy_1_1_b_l_l_1_1_update_usage_stats_list_request_json">UpdateUsageStatsListRequestJson</link></computeroutput> encapsulates the usage statistics list information to be sent to the server </para>
</listitem>
        </itemizedlist>
