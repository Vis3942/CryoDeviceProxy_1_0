<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ output extension=".txt" #>
<#
    int major    = 1;
    int minor    = 2; // Official == even, Preview == odd; 1.0 original release (no versionsing data in app)
    int build    = 0;
 
    string version = String.Format("{0}.{1}.{2}", major, minor, build);
 
    if (minor % 2 == 1) // Preview build
    {
        // Auto-generate the build
        DateTime ProjectStartedDate = new DateTime(year: 2021, month: 3, day: 3);
        int DaysSinceProjectStarted = (int)((DateTime.UtcNow - ProjectStartedDate).TotalDays);

        int MinutesSinceMidnight = (int)DateTime.UtcNow.TimeOfDay.TotalMinutes;
        build = (DaysSinceProjectStarted) + MinutesSinceMidnight;
        version = String.Format("{0}.{1}.{2}", major, minor, build);
    }
    Write(version);
 #>